{
  "name": "eyeblinkdetect",
  "version": "0.1.0",
  "description": "Chrome extension that tracks blink rate via webcam and reminds you to rest your eyes.",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "npm run build && playwright test",
    "check": "npm run typecheck && npm run test"
  },
  "keywords": ["chrome-extension", "blink-detection", "eye-strain", "mediapipe"],
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@playwright/test": "^1.64.0",
    "@types/chrome": "^0.1.42",
    "@types/node": "^25.9.1",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vite-plugin-static-copy": "^4.1.0",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "chart.js": "^4.5.1",
    "idb": "^8.0.3"
  }
}
